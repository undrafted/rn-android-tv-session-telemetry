%%{init: {"theme": "neutral"}}%%
flowchart LR
    subgraph Device["Android TV device"]
        direction TB
        App["TV app<br/>react-native-tvos"]
        Lib["Telemetry library<br/>+ Redux middleware & selector wrapper"]
        Network["Automatic network capture<br/>RN fetch + XHR clients<br/>redacted metadata only"]
        Stalls["Automatic JS stall sampler<br/>one timer, monotonic lateness"]
        Buffer["Event buffer"]
        FrameTiming["Native frame timing<br/>FrameMetrics"]
        GlobalFocus["Native global focus listener<br/>ViewTreeObserver + nativeID"]
        Collector["Android collector<br/>lifecycle<br/>(planned)"]
        Writer["On-device session writer<br/>.rnst chunks (JNI)"]
        App --> Lib
        App --> Network --> Lib
        Stalls --> Lib
        FrameTiming --> Lib
        GlobalFocus --> Lib
        Lib --> Buffer
        Lib -->|native bridge: events · start/finish| Writer
        Collector -.-> Writer
    end

    subgraph Transport["ADB transport"]
        direction TB
        Discover["Device discovery"]
        LiveRoute["Live route<br/>(watch — read-only poll)"]
        Pull["Pull + verify<br/>(run-as + checksum)"]
        Retain["Session retention<br/>(wired into pull)"]
        Discover --> LiveRoute
        Discover --> Pull
        Pull --> Retain
    end

    subgraph Host["Rust host"]
        direction TB
        CLI["CLI<br/>doctor · devices · analyze · report<br/>record --package · stop · mark · status · watch · pull"]
        Protocol["Protocol<br/>event schema"]
        SessionCrate["Session<br/>chunking · rotation · budget · checksums"]
        Analysis["Analysis<br/>clock mapping · windows · detectors · selector stats · QA bookmarks"]
        Report["Report<br/>JSON + HTML"]
        CLI --> Protocol --> SessionCrate --> Analysis --> Report
    end

    App --> Discover
    Writer --> Pull
    Writer --> LiveRoute
    Pull --> CLI
    LiveRoute --> CLI
    Buffer -->|fixture| CLI
    CLI -->|adb broadcast: start/stop session| Writer