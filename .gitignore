# Node
node_modules/
dist/
*.tsbuildinfo
npm-debug.log*

# Rust
target/

# Android/React Native: each app under apps/*/ ships its own .gitignore (from the RN CLI
# template) scoped to that app's own android/, node_modules/, build artifacts, etc. Native
# library modules (e.g. packages/*/android/) have no such template, so their Gradle build
# output is ignored here instead.
**/android/build/

# Cross-compiled by cargo-ndk (see packages/react-native/android/build.gradle) - generated,
# not source.
packages/react-native/android/src/main/jniLibs/

# Recorded sessions (large, machine-specific — keep fixtures/sessions curated instead)
*.rnst

# Generated by `session-telemetry report`, not a source fixture
fixtures/sessions/*.html

# `session-telemetry pull`'s default output directory
/pulled-sessions/

# Editors / OS
.DS_Store
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
.idea/

# Env
.env
.env.local

# Local-only planning doc, kept out of the public repo
plan.md

# Claude Code local settings (per-developer, not shared)
.claude/settings.local.json
